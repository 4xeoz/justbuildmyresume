// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User authentication and account
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       UserProfile?
  experiences   Experience[]
  resumes       Resume[]
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

// NextAuth session management
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User profile information
model UserProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  phone           String?
  location        String?
  headline        String?  @db.Text
  summary         String?  @db.Text
  linkedinUrl     String?
  githubUrl       String?
  portfolioUrl    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Experience types enum
enum ExperienceType {
  JOB
  PROJECT
  VOLUNTEER
  EDUCATION
}

// User experiences (jobs, projects, etc.)
model Experience {
  id            String          @id @default(cuid())
  userId        String
  type          ExperienceType  @default(JOB)
  title         String
  organization  String
  location      String?
  startDate     DateTime
  endDate       DateTime?
  isCurrentRole Boolean         @default(false)
  description   String          @db.Text
  skills        String[]
  keywords      String[]
  displayOrder  Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  highlights    Highlight[]

  @@index([userId])
  @@map("experiences")
}

// Highlights for each experience
model Highlight {
  id            String     @id @default(cuid())
  experienceId  String
  content       String     @db.Text
  skills        String[]
  metrics       String[]
  displayOrder  Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  experience    Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@map("highlights")
}

// Generated resumes
model Resume {
  id                String   @id @default(cuid())
  userId            String
  jobTitle          String
  companyName       String
  jobDescription    String   @db.Text
  analysisResult    Json?
  selectedExpIds    String[]
  tailoredContent   Json?
  latexCode         String   @db.Text
  coverLetter       String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("resumes")
}
